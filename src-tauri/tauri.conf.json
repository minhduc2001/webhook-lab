{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webhook-lab",
  "version": "0.2.0",
  "identifier": "com.minhduc.webhooklab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Webhook Lab",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRkVGRDg5MDBENTY3NzEKUldSeFo5VUFpZjMrek9QRk0yOW9xTk5kaUg5NDc4VkVrckllSnV2VW9raHZQbUpleklsOTExQTMK",
      "endpoints": [
        "https://github.com/minhduc2001/webhook-lab/releases/latest/download/latest.json"
      ]
    }
  }
}
